#!/bin/bash
# .githooks/pre-push
# Segunda línea de defensa antes de subir al remoto

RAMA_ACTUAL=$(git symbolic-ref --short HEAD 2>/dev/null)
RAMAS_PROTEGIDAS=("main" "master" "develop" "staging")

for RAMA in "${RAMAS_PROTEGIDAS[@]}"; do
  if [ "$RAMA_ACTUAL" = "$RAMA" ]; then
    echo ""
    echo "🚫 [PRE-PUSH] No puedes hacer push directo a '$RAMA_ACTUAL'."
    echo "   Usa un Pull Request / Merge Request desde GitLab."
    echo ""
    exit 1
  fi
done

exit 0