---
import { Icon } from 'astro-icon/components';
import { getSearchIndex } from '../lib/content';

// The index is built at compile time and embedded in the page, so search runs
// fully client-side with no backend — a good fit for a static S3/CloudFront site.
const searchIndex = await getSearchIndex();
---

<div class="relative w-full" data-search-root>
  <label class="relative block">
    <span class="sr-only">Buscar hojas de trucos</span>
    <Icon
      name="mdi:magnify"
      class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"
    />
    <input
      type="search"
      autocomplete="off"
      placeholder="Buscar comandos, etiquetas o categorías…"
      class="w-full rounded-lg border border-slate-200 bg-white py-2 pl-10 pr-4 text-sm text-slate-800 placeholder:text-slate-400 shadow-sm transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-500"
      data-search-input
      aria-label="Buscar hojas de trucos"
    />
  </label>

  <div
    class="absolute left-0 right-0 top-full z-40 mt-2 hidden max-h-96 overflow-y-auto rounded-xl border border-slate-200 bg-white p-2 shadow-xl dark:border-slate-700 dark:bg-slate-900"
    data-search-results
    role="listbox"
  >
  </div>
</div>

<script define:vars={{ searchIndex }}>
  const root = document.querySelector('[data-search-root]');
  if (root) {
    const input = root.querySelector('[data-search-input]');
    const results = root.querySelector('[data-search-results]');

    const normalize = (value) =>
      value
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');

    const render = (matches, query) => {
      if (!query) {
        results.classList.add('hidden');
        results.innerHTML = '';
        return;
      }

      if (matches.length === 0) {
        results.innerHTML =
          '<p class="px-3 py-4 text-center text-sm text-slate-500 dark:text-slate-400">No se encontraron resultados.</p>';
        results.classList.remove('hidden');
        return;
      }

      results.innerHTML = matches
        .slice(0, 8)
        .map(
          (item) => `
            <a href="${item.url}" role="option"
               class="block rounded-lg px-3 py-2 transition hover:bg-slate-100 dark:hover:bg-slate-800">
              <div class="flex items-center justify-between gap-2">
                <span class="font-medium text-slate-800 dark:text-slate-100">${item.title}</span>
                <span class="shrink-0 rounded-full bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700 dark:bg-brand-500/10 dark:text-brand-400">${item.category}</span>
              </div>
              <p class="mt-0.5 line-clamp-1 text-xs text-slate-500 dark:text-slate-400">${item.description}</p>
            </a>`
        )
        .join('');
      results.classList.remove('hidden');
    };

    const search = (rawQuery) => {
      const query = normalize(rawQuery.trim());
      if (!query) return [];
      return searchIndex.filter((item) => {
        const haystack = normalize(
          [item.title, item.description, item.category, item.tags.join(' ')].join(' ')
        );
        return haystack.includes(query);
      });
    };

    input.addEventListener('input', (event) => {
      const query = event.target.value;
      render(search(query), query.trim());
    });

    // Close the dropdown when clicking outside.
    document.addEventListener('click', (event) => {
      if (!root.contains(event.target)) {
        results.classList.add('hidden');
      }
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        input.value = '';
        render([], '');
        input.blur();
      }
    });
  }
</script>
