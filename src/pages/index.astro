---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCheatSheetsByCategory, getPublishedCheatSheets, sheetUrl } from '../lib/content';
import { SITE } from '../consts';

const groups = await getCheatSheetsByCategory();
const total = (await getPublishedCheatSheets()).length;
---

<BaseLayout>
  <section class="mb-10 max-w-3xl sm:mb-12">
    <p class="text-sm text-slate-500 dark:text-slate-400">
      {total} {total === 1 ? 'hoja disponible' : 'hojas disponibles'}
    </p>
    <h1 class="mt-2 font-display text-5xl font-extrabold tracking-tight text-slate-900 sm:text-6xl dark:text-white">
      {SITE.title}
    </h1>
    <p class="mt-4 text-base text-slate-600 sm:text-lg dark:text-slate-400">
      {SITE.description} Toca un comando para copiarlo.
    </p>
  </section>

  {
    groups.length === 0 ? (
      <p class="text-slate-500 dark:text-slate-400">
        Todavía no hay hojas de trucos. Crea tu primer archivo en
        <code class="rounded bg-slate-100 px-1 dark:bg-slate-800">src/content/cheatsheets/</code>.
      </p>
    ) : (
      <div class="space-y-10">
        {groups.map((group) => (
          <section aria-labelledby={`cat-${group.id}`}>
            <h2
              id={`cat-${group.id}`}
              class="mb-3 flex items-center gap-2 font-display text-xl font-bold text-slate-900 dark:text-white"
            >
              <Icon name={group.icon} class="h-5 w-5 text-brand-600 dark:text-brand-400" />
              {group.label}
            </h2>

            <ul class="sheet-index">
              {group.sheets.map((sheet) => (
                <li>
                  <a href={sheetUrl(sheet)} class="sheet-row group">
                    <span class="sheet-row-icon">
                      <Icon name={sheet.data.icon} class="h-5 w-5" />
                    </span>
                    <span class="min-w-0">
                      <span class="block font-semibold text-slate-900 dark:text-white">
                        {sheet.data.title}
                      </span>
                      <span class="mt-0.5 block text-sm text-slate-600 dark:text-slate-400">
                        {sheet.data.description}
                      </span>
                    </span>
                    <Icon
                      name="mdi:chevron-right"
                      class="h-5 w-5 shrink-0 text-slate-400 transition group-hover:translate-x-0.5 group-hover:text-brand-600 dark:group-hover:text-brand-400"
                    />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>
