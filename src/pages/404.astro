---
/**
 * 404 page — "lost in the shell".
 *
 * Built as dist/404.html, which CloudFront serves (with status 404) for any
 * path that does not exist in the bucket. The page plays a short terminal
 * session explaining the missing route, suggests the closest cheat sheets
 * and lets visitors type a few shell commands to find their way back.
 *
 * Works without JavaScript: the static terminal lines, the first suggestions
 * and the "back home" link are rendered at build time.
 */
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedCheatSheets, sheetUrl } from '../lib/content';

const sheets = await getPublishedCheatSheets();

// Lightweight index for the in-page terminal (ls, cd, grep, suggestions).
const terminalIndex = sheets.map((sheet) => ({
  slug: sheet.slug,
  title: sheet.data.title,
  category: sheet.data.category,
  tags: sheet.data.tags,
}));

// Number of suggestion cards shown below the terminal.
const SUGGESTIONS = 3;
---

<BaseLayout title="Página no encontrada" description="Esta ruta no existe en Guías. Vuelve al inicio o busca una hoja de trucos.">
  <section class="nf mx-auto max-w-4xl">
    {/* --- Hero ------------------------------------------------------------ */}
    <header class="nf-hero">
      <p class="nf-exit" aria-hidden="true">
        <span class="nf-exit-dot"></span>
        exit code
      </p>
      <h1 class="nf-code" data-text="404">404</h1>
      <p class="nf-title">
        Esta ruta no aparece en ninguna guía
      </p>
      <p class="nf-subtitle">
        Ni <code>grep</code>, ni <code>find</code>, ni <code>git log</code> la encontraron.
        Prueba alguno de los comandos de abajo o escribe <code>help</code> en la terminal.
      </p>
    </header>

    {/* --- Interactive terminal ------------------------------------------- */}
    <div class="term-window nf-term" id="nf-term">
      <div class="term-header">
        <div class="term-title">
          <span class="term-dots" aria-hidden="true">
            <span class="term-dot term-dot-red"></span>
            <span class="term-dot term-dot-amber"></span>
            <span class="term-dot term-dot-green"></span>
          </span>
          <span class="term-lang">visitante@guias: ~/404 — zsh</span>
        </div>
        <span class="nf-term-badge">interactiva</span>
      </div>

      <div class="nf-term-body" id="nf-term-body">
        {/* Static session: shown as-is without JS, replayed with typing when JS runs. */}
        <ol class="nf-lines" id="nf-lines" aria-live="polite">
          <li class="nf-line"><span class="nf-ps1">$</span> <span class="nf-bin">cd</span> <span class="nf-arg" data-path>/ruta-desconocida</span></li>
          <li class="nf-line nf-err">cd: no existe el archivo o el directorio: <span data-path>/ruta-desconocida</span></li>
          <li class="nf-line"><span class="nf-ps1">$</span> <span class="nf-bin">curl</span> <span class="nf-flag">-I</span> <span class="nf-arg">https://guias.maldolabs.com<span data-path>/ruta-desconocida</span></span></li>
          <li class="nf-line nf-out"><span class="nf-warn">HTTP/2 404</span> · la página se fue a <code>/dev/null</code></li>
          <li class="nf-line nf-hint" id="nf-hint">Escribe <kbd>help</kbd> para ver los comandos, o <kbd>cd ~</kbd> para volver al inicio.</li>
        </ol>

        <form class="nf-prompt" id="nf-form" autocomplete="off" hidden>
          <label for="nf-input" class="nf-ps1">$</label>
          <input
            id="nf-input"
            class="nf-input"
            type="text"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            enterkeyhint="go"
            aria-label="Escribe un comando (prueba help)"
            placeholder="help"
          />
        </form>
      </div>
    </div>

    {/* --- Quick actions ---------------------------------------------------- */}
    <div class="nf-actions">
      <a href="/" class="cmd nf-action">
        <span class="cmd-prompt" aria-hidden="true">$</span>
        <code class="cmd-text"><span class="tok tok-bin">cd</span> <span class="tok tok-arg">~</span></code>
        <span class="nf-action-label">
          <Icon name="mdi:home-outline" class="h-4 w-4" /> Inicio
        </span>
      </a>
      <a href={sheets.length ? sheetUrl(sheets[0]) : '/'} class="cmd nf-action" id="nf-random">
        <span class="cmd-prompt" aria-hidden="true">$</span>
        <code class="cmd-text"><span class="tok tok-bin">shuf</span> <span class="tok tok-flag">-n1</span> <span class="tok tok-arg">guias/*</span></code>
        <span class="nf-action-label">
          <Icon name="mdi:dice-5-outline" class="h-4 w-4" /> Guía al azar
        </span>
      </a>
    </div>

    {/* --- Suggestions -------------------------------------------------------- */}
    {
      sheets.length > 0 && (
        <section class="mt-10" aria-labelledby="nf-suggest-title">
          <h2
            id="nf-suggest-title"
            class="mb-3 flex items-center gap-2 font-display text-xl font-bold text-slate-900 dark:text-white"
          >
            <Icon name="mdi:compass-outline" class="h-5 w-5 text-brand-600 dark:text-brand-400" />
            <span id="nf-suggest-label">Quizá te sirva alguna de estas</span>
          </h2>

          {/* Every sheet is rendered; the script shows the closest matches. */}
          <ul class="sheet-index" id="nf-suggestions">
            {sheets.map((sheet, index) => (
              <li data-slug={sheet.slug} hidden={index >= SUGGESTIONS}>
                <a href={sheetUrl(sheet)} class="sheet-row group">
                  <span class="sheet-row-icon">
                    <Icon name={sheet.data.icon} class="h-5 w-5" />
                  </span>
                  <span class="min-w-0">
                    <span class="block font-semibold text-slate-900 dark:text-white">
                      {sheet.data.title}
                    </span>
                    <span class="mt-0.5 block text-sm text-slate-600 dark:text-slate-400">
                      {sheet.data.description}
                    </span>
                  </span>
                  <Icon
                    name="mdi:chevron-right"
                    class="h-5 w-5 shrink-0 text-slate-400 transition group-hover:translate-x-0.5 group-hover:text-brand-600 dark:group-hover:text-brand-400"
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </section>

  <script type="application/json" id="nf-index" set:html={JSON.stringify(terminalIndex)} />

  <script>
    interface SheetEntry {
      slug: string;
      title: string;
      category: string;
      tags: string[];
    }

    const SUGGESTIONS = 3;
    const index: SheetEntry[] = JSON.parse(document.getElementById('nf-index')?.textContent ?? '[]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // --- Requested path ------------------------------------------------------
    // Always inserted with textContent: the path comes from the URL (user input).
    const rawPath = decodeURIComponent(window.location.pathname) || '/';
    const shownPath = rawPath.length > 48 ? `${rawPath.slice(0, 45)}…` : rawPath;
    document.querySelectorAll('[data-path]').forEach((node) => (node.textContent = shownPath));

    // --- Fuzzy matching ------------------------------------------------------
    const normalize = (value: string) =>
      value
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();

    const levenshtein = (a: string, b: string): number => {
      if (a === b) return 0;
      if (!a.length) return b.length;
      if (!b.length) return a.length;
      let previous = Array.from({ length: b.length + 1 }, (_, i) => i);
      for (let i = 1; i <= a.length; i++) {
        const current = [i];
        for (let j = 1; j <= b.length; j++) {
          const cost = a[i - 1] === b[j - 1] ? 0 : 1;
          current[j] = Math.min(previous[j] + 1, current[j - 1] + 1, previous[j - 1] + cost);
        }
        previous = current;
      }
      return previous[b.length];
    };

    /** Similarity in [0, 1] between the query and one sheet (slug, title and tags). */
    const score = (query: string, sheet: SheetEntry): number => {
      if (!query) return 0;
      const candidates = [sheet.slug, sheet.title, ...sheet.tags].map(normalize).filter(Boolean);
      let best = 0;
      for (const candidate of candidates) {
        if (candidate === query) return 1;
        if (candidate.includes(query) || query.includes(candidate)) {
          best = Math.max(best, 0.85);
          continue;
        }
        const distance = levenshtein(query, candidate);
        best = Math.max(best, 1 - distance / Math.max(query.length, candidate.length));
      }
      return best;
    };

    const rank = (query: string) =>
      index
        .map((sheet) => ({ sheet, value: score(normalize(query), sheet) }))
        .sort((a, b) => b.value - a.value);

    // Use the last meaningful segment of the path as the search term.
    const pathQuery = rawPath.split('/').filter(Boolean).pop() ?? '';
    const ranked = rank(pathQuery);
    const closeMatches = ranked.filter((entry) => entry.value >= 0.45);
    const bestMatch = closeMatches[0]?.sheet;

    // --- Suggestion cards ----------------------------------------------------
    const suggestionItems = [...document.querySelectorAll<HTMLLIElement>('#nf-suggestions > li')];
    const pickRandom = () => [...index].sort(() => Math.random() - 0.5);
    const chosen = (closeMatches.length ? closeMatches.map((e) => e.sheet) : pickRandom()).slice(0, SUGGESTIONS);
    const chosenSlugs = new Set(chosen.map((sheet) => sheet.slug));
    suggestionItems.forEach((item) => (item.hidden = !chosenSlugs.has(item.dataset.slug ?? '')));
    // Keep the most relevant card first.
    const list = document.getElementById('nf-suggestions');
    chosen.forEach((sheet) => {
      const item = suggestionItems.find((li) => li.dataset.slug === sheet.slug);
      if (item) list?.appendChild(item);
    });
    const suggestLabel = document.getElementById('nf-suggest-label');
    if (suggestLabel && closeMatches.length) suggestLabel.textContent = '¿Quizá buscabas…?';

    // Random sheet button.
    const randomLink = document.getElementById('nf-random') as HTMLAnchorElement | null;
    const randomSheet = () => index[Math.floor(Math.random() * index.length)];
    if (randomLink && index.length) {
      randomLink.addEventListener('click', (event) => {
        event.preventDefault();
        window.location.href = `/${randomSheet().slug}`;
      });
    }

    // --- Terminal ------------------------------------------------------------
    const lines = document.getElementById('nf-lines') as HTMLOListElement;
    const body = document.getElementById('nf-term-body') as HTMLDivElement;
    const form = document.getElementById('nf-form') as HTMLFormElement;
    const input = document.getElementById('nf-input') as HTMLInputElement;
    const history: string[] = [];
    let historyCursor = 0;

    type Part = string | { text: string; cls: string };

    /** Append one output line. Every piece goes through textContent (no HTML injection). */
    const print = (parts: Part[] | string, cls = 'nf-out') => {
      const li = document.createElement('li');
      li.className = `nf-line ${cls}`;
      for (const part of Array.isArray(parts) ? parts : [parts]) {
        if (typeof part === 'string') {
          li.append(part);
        } else {
          const span = document.createElement('span');
          span.className = part.cls;
          span.textContent = part.text;
          li.append(span);
        }
      }
      lines.append(li);
      body.scrollTop = body.scrollHeight;
      return li;
    };

    const echoCommand = (command: string) => {
      const [bin, ...args] = command.split(/\s+/);
      const parts: Part[] = [{ text: '$', cls: 'nf-ps1' }, ' ', { text: bin, cls: 'nf-bin' }];
      for (const arg of args) {
        parts.push(' ', { text: arg, cls: arg.startsWith('-') ? 'nf-flag' : 'nf-arg' });
      }
      print(parts, '');
    };

    const go = (url: string, message: string) => {
      print([{ text: '→ ', cls: 'nf-ok' }, message], 'nf-out');
      window.setTimeout(() => (window.location.href = url), reduceMotion ? 0 : 450);
    };

    const findSheet = (name: string) => {
      const query = normalize(name.replace(/^\.?\//, '').replace(/\/$/, ''));
      return index.find((sheet) => normalize(sheet.slug) === query || normalize(sheet.title) === query);
    };

    const commands: Record<string, (args: string[]) => void> = {
      help: () => {
        print('Comandos disponibles:');
        const rows: [string, string][] = [
          ['ls', 'lista todas las guías'],
          ['cd <guía>', 'abre una guía (Tab autocompleta)'],
          ['cd ~', 'vuelve al inicio'],
          ['grep <texto>', 'busca guías por nombre o etiqueta'],
          ['random', 'te lleva a una guía al azar'],
          ['pwd · whoami · date', 'lo de siempre'],
          ['clear', 'limpia la pantalla'],
        ];
        rows.forEach(([cmd, desc]) => print(['  ', { text: cmd.padEnd(22, ' '), cls: 'nf-bin' }, desc]));
        print('…y quizá uno que otro comando escondido.', 'nf-dim');
      },
      ls: () => {
        index.forEach((sheet) =>
          print([{ text: `${sheet.slug}/`, cls: 'nf-dir' }, '  ', { text: sheet.category, cls: 'nf-dim' }]),
        );
        print(`${index.length} guías`, 'nf-dim');
      },
      cd: (args) => {
        const target = args[0] ?? '~';
        if (['~', '/', '..', '-', '~/'].includes(target)) return go('/', 'cd ~ · volviendo al inicio');
        const sheet = findSheet(target);
        if (sheet) return go(`/${sheet.slug}`, `abriendo ${sheet.title}`);
        print(`cd: no existe el archivo o el directorio: ${target}`, 'nf-err');
        const suggestion = rank(target).find((entry) => entry.value >= 0.45)?.sheet;
        if (suggestion) print(['¿Quisiste decir ', { text: `cd ${suggestion.slug}`, cls: 'nf-bin' }, '?'], 'nf-hint');
      },
      grep: (args) => {
        const term = args.filter((arg) => !arg.startsWith('-')).join(' ');
        if (!term) return print('uso: grep <texto>', 'nf-err');
        const matches = rank(term).filter((entry) => entry.value >= 0.5).slice(0, 8);
        if (!matches.length) return print(`grep: 0 coincidencias para "${term}"`, 'nf-err');
        matches.forEach(({ sheet }) => print([{ text: `${sheet.slug}/`, cls: 'nf-dir' }, '  ', sheet.title]));
      },
      random: () => {
        const sheet = randomSheet();
        if (sheet) go(`/${sheet.slug}`, `la suerte eligió ${sheet.title}`);
      },
      pwd: () => print(rawPath),
      whoami: () => print('visitante — curioso, valiente y temporalmente perdido'),
      date: () =>
        print(new Date().toLocaleString('es-MX', { dateStyle: 'full', timeStyle: 'short' })),
      echo: (args) => print(args.join(' ')),
      clear: () => lines.replaceChildren(),
      history: () => history.forEach((entry, i) => print(`  ${String(i + 1).padStart(3, ' ')}  ${entry}`)),
      exit: () => go('/', 'no hay salida… excepto esta'),
      // --- Easter eggs ---------------------------------------------------------
      sudo: () =>
        print('visitante no está en el archivo sudoers. Este incidente será reportado. 🚨', 'nf-err'),
      rm: (args) =>
        args.join(' ').includes('-rf')
          ? print('rm: permiso denegado. Las guías viven en S3 con versionado, ni lo intentes 😌', 'nf-err')
          : print('rm: aquí no hay nada que borrar… literalmente es un 404', 'nf-err'),
      vim: () => print('Entraste a vim. Para salir escribe :q (sí, ese es el chiste).', 'nf-warn'),
      nvim: () => commands.vim([]),
      ':q': () => print('Saliste de vim. Ahora sal de aquí con cd ~ 😉', 'nf-ok'),
      ':wq': () => commands[':q']([]),
      git: (args) =>
        args[0] === 'blame'
          ? print('git blame: la culpa es de quien escribió la URL 👀', 'nf-warn')
          : print('git: estás en la rama 404-detached-HEAD. Prueba cd ~', 'nf-warn'),
      ping: () => {
        print('PING guias.maldolabs.com: 56 bytes de datos');
        [12, 9, 404].forEach((ms, i) =>
          print(`64 bytes desde cloudfront: icmp_seq=${i} ttl=64 tiempo=${ms} ms`, ms === 404 ? 'nf-warn' : 'nf-out'),
        );
      },
      coffee: () => print('☕ Error 418: soy una tetera, no una cafetera.', 'nf-warn'),
      hello: () => print('¡Hola! 👋 Escribe help si quieres salir de aquí.', 'nf-ok'),
      hola: () => commands.hello([]),
    };

    const run = (raw: string) => {
      const command = raw.trim();
      if (!command) return;
      echoCommand(command);
      history.push(command);
      historyCursor = history.length;
      const [bin, ...args] = command.split(/\s+/);
      const handler = commands[bin.toLowerCase()];
      if (handler) return handler(args);
      print(`zsh: comando no encontrado: ${bin}`, 'nf-err');
      if (findSheet(bin)) print(['Eso es una guía. Prueba ', { text: `cd ${bin}`, cls: 'nf-bin' }], 'nf-hint');
      else print(['Prueba ', { text: 'help', cls: 'nf-bin' }], 'nf-dim');
    };

    // Tab completes guide names after "cd ".
    const complete = () => {
      const match = input.value.match(/^(\s*cd\s+)(\S*)$/);
      if (!match) return;
      const [, prefix, partial] = match;
      const options = index.map((sheet) => sheet.slug).filter((slug) => slug.startsWith(partial.toLowerCase()));
      if (options.length === 1) {
        input.value = `${prefix}${options[0]}`;
      } else if (options.length > 1) {
        echoCommand(input.value.trim());
        print(options.join('   '), 'nf-dir');
      }
    };

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Tab') {
        event.preventDefault();
        complete();
      } else if (event.key === 'ArrowUp' && history.length) {
        event.preventDefault();
        historyCursor = Math.max(0, historyCursor - 1);
        input.value = history[historyCursor] ?? '';
      } else if (event.key === 'ArrowDown' && history.length) {
        event.preventDefault();
        historyCursor = Math.min(history.length, historyCursor + 1);
        input.value = history[historyCursor] ?? '';
      } else if (event.key === 'l' && event.ctrlKey) {
        event.preventDefault();
        commands.clear([]);
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      run(input.value);
      input.value = '';
    });

    // Clicking anywhere in the terminal focuses the prompt (without scrolling).
    document.getElementById('nf-term')?.addEventListener('click', (event) => {
      if (window.getSelection()?.toString()) return;
      if (!(event.target instanceof HTMLAnchorElement)) input.focus({ preventScroll: true });
    });

    // --- Intro: replay the static session with a typing effect ---------------
    const showPrompt = () => {
      form.hidden = false;
      if (bestMatch) {
        print(['¿Quizá buscabas ', { text: `cd ${bestMatch.slug}`, cls: 'nf-bin' }, '?'], 'nf-hint');
      }
    };

    const intro = async () => {
      const staticLines = [...lines.children] as HTMLElement[];
      if (reduceMotion) return showPrompt();

      staticLines.forEach((line) => (line.hidden = true));
      const sleep = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, ms));

      for (const line of staticLines) {
        line.hidden = false;
        // Type command lines character by character; reveal output lines at once.
        if (line.querySelector('.nf-ps1')) {
          const textNodes: Text[] = [];
          const walker = document.createTreeWalker(line, NodeFilter.SHOW_TEXT);
          while (walker.nextNode()) textNodes.push(walker.currentNode as Text);
          const full = textNodes.map((node) => node.data);
          textNodes.forEach((node) => (node.data = ''));
          line.classList.add('is-typing');
          for (let n = 0; n < textNodes.length; n++) {
            for (const char of full[n]) {
              textNodes[n].data += char;
              await sleep(char === ' ' ? 18 : 26);
            }
          }
          line.classList.remove('is-typing');
          await sleep(220);
        } else {
          await sleep(160);
        }
      }
      showPrompt();
    };

    intro();
  </script>
</BaseLayout>

<style is:global>
  /* Global on purpose: the terminal creates lines at runtime, and scoped styles
     would not reach them. Every class is namespaced with the nf- prefix. */
  /* --- Hero --------------------------------------------------------------- */
  .nf-hero {
    margin-bottom: 1.75rem;
  }
  .nf-exit {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid rgb(244 63 94 / 0.35);
    border-radius: 999px;
    background: rgb(244 63 94 / 0.08);
    color: #e11d48;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  html.dark .nf-exit {
    color: #fb7185;
  }
  .nf-exit-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: currentColor;
    animation: nf-pulse 1.6s ease-in-out infinite;
  }

  .nf-code {
    position: relative;
    display: block;
    width: fit-content;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(5.5rem, 22vw, 10rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    background: linear-gradient(120deg, var(--color-brand-600), #a855f7 55%, #ec4899);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  /* Two offset copies give a short RGB glitch every few seconds. */
  .nf-code::before,
  .nf-code::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    background: inherit;
    -webkit-background-clip: text;
    background-clip: text;
    opacity: 0;
    pointer-events: none;
  }
  .nf-code::before {
    text-shadow: -3px 0 rgb(56 189 248 / 0.55);
    animation: nf-glitch 4.5s steps(1) infinite;
  }
  .nf-code::after {
    text-shadow: 3px 0 rgb(236 72 153 / 0.55);
    animation: nf-glitch 4.5s steps(1) 0.08s infinite reverse;
  }

  .nf-title {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-slate-900);
  }
  html.dark .nf-title {
    color: var(--color-white);
  }
  .nf-subtitle {
    margin-top: 0.6rem;
    max-width: 40rem;
    color: var(--color-slate-600);
  }
  html.dark .nf-subtitle {
    color: var(--color-slate-400);
  }
  .nf-subtitle code {
    padding: 0.05rem 0.35rem;
    border-radius: 0.3rem;
    background: var(--color-brand-50);
    color: var(--color-brand-700);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
  html.dark .nf-subtitle code {
    background: rgb(99 102 241 / 0.15);
    color: var(--color-brand-300);
  }

  /* --- Terminal ------------------------------------------------------------ */
  .nf-term {
    margin: 0;
    cursor: text;
    box-shadow:
      0 20px 45px -20px rgb(79 70 229 / 0.45),
      0 4px 12px rgb(2 6 23 / 0.15);
  }
  .nf-term-badge {
    padding: 0.15rem 0.55rem;
    border: 1px solid rgb(129 140 248 / 0.35);
    border-radius: 999px;
    color: #a5b4fc;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }
  .nf-term-body {
    max-height: 22rem;
    overflow-y: auto;
    padding: 1rem 1.125rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.7;
    color: #e2e8f0;
    scrollbar-width: thin;
    scrollbar-color: #334155 transparent;
  }
  .nf-lines {
    margin: 0;
    padding: 0;
    list-style: none;
