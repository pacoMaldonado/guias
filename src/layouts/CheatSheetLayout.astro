---
import { Icon } from 'astro-icon/components';
import BaseLayout from './BaseLayout.astro';
import type { CheatSheet } from '../lib/content';

interface Props {
  sheet: CheatSheet;
}

const { sheet } = Astro.props;
const { title, description, category, icon, tags, lastUpdated } = sheet.data;

const formattedDate = lastUpdated
  ? new Intl.DateTimeFormat('es-ES', { dateStyle: 'long' }).format(lastUpdated)
  : null;
---

<BaseLayout title={title} description={description}>
  <article class="w-full">
    <header class="mb-8 border-b border-slate-200 pb-6 dark:border-slate-800">
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <span
          class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700 dark:bg-brand-500/10 dark:text-brand-400"
        >
          <Icon name={icon} class="h-4 w-4" />
          {category}
        </span>
        {
          formattedDate && (
            <span class="inline-flex items-center gap-1 text-xs text-slate-400 dark:text-slate-500">
              <Icon name="mdi:update" class="h-4 w-4" />
              Actualizado el {formattedDate}
            </span>
          )
        }
      </div>

      <h1 class="font-display text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl dark:text-white">
        {title}
      </h1>
      <p class="mt-3 max-w-3xl text-lg text-slate-600 dark:text-slate-400">{description}</p>

      {
        tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                #{tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div
      class="prose prose-slate sheet-body max-w-none dark:prose-invert prose-pre:bg-slate-900 prose-pre:text-slate-100 prose-a:text-brand-600 dark:prose-a:text-brand-400 prose-headings:scroll-mt-20"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
