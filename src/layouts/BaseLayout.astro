---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = new URL('/og-image.png', Astro.site ?? Astro.url.origin).toString();
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.toString()} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.title}: ${SITE.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Apply the saved theme before paint to avoid a flash of the wrong theme. */}
    <script is:inline>
      // Lets CSS enable JS-only enhancements (e.g. collapsed long code blocks).
      document.documentElement.classList.add('js');
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>

  <body class="min-h-screen">
    <Header />

    <div class="flex w-full">
      <Sidebar />
      <main id="main" tabindex="-1" class="page-main min-w-0 flex-1 py-6 outline-none sm:py-8 lg:py-10">
        <slot />
      </main>
    </div>

    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <button type="button" id="to-top" class="to-top" aria-label="Volver arriba" title="Volver arriba">
      <Icon name="mdi:arrow-up" class="h-5 w-5" />
    </button>

    {/* Clipboard support for every code block on the page. */}
    <script>
      const COPY_LABEL = 'Copiar';

      const buildCommandBoxHtml = (rawCmd: string) => {
        const command = rawCmd.trim();
        const isEx = command.startsWith(':');
        const prompt = isEx ? ':' : '$';
        const displayCmd = isEx ? command.slice(1).trimStart() : command;
        let seenFirst = false;
        const tokensHtml = displayCmd
          .split(/(\s+)/)
          .filter(Boolean)
          .map((part) => {
            if (/^\s+$/.test(part)) return part;
            let cls = 'tok-arg';
            if (!seenFirst) {
              seenFirst = true;
              cls = isEx ? 'tok-ex' : 'tok-bin';
            } else if (/^--?[a-zA-Z0-9]/.test(part)) {
              cls = 'tok-flag';
            } else if (/^(\|\||&&|\||>|>>|2>&1)$/.test(part)) {
              cls = 'tok-op';
            } else if (/^(<[^>]+>|\[[^\]]+\]|%)$/.test(part)) {
              cls = 'tok-var';
            }
            const escaped = part.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            const long = part.length > 28 ? ' tok-long' : '';
            return `<span class="tok ${cls}${long}">${escaped}</span>`;
          })
          .join('');
        const attrCmd = command.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
        return `<button type="button" class="cmd ${isEx ? 'cmd-ex' : 'cmd-shell'}" data-copy="${attrCmd}" aria-label="Copiar comando: ${attrCmd}"><span class="cmd-prompt" aria-hidden="true">${prompt}</span><code class="cmd-text">${tokensHtml}</code><span class="cmd-state" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="cmd-icon-copy"><path d="M19 21H8V7h11m0-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2m-3-4H4a2 2 0 0 0-2 2v14h2V3h12z" fill="currentColor"></path></svg><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="cmd-icon-done"><path d="M21 7 9 19l-5.5-5.5 1.41-1.41L9 16.17 19.59 5.59z" fill="currentColor"></path></svg><span class="cmd-state-label">${COPY_LABEL}</span><span class="cmd-state-done">¡Copiado!</span></span></button>`;
      };

      // Upgrade any cached .cmd buttons (e.g. from astro dev in-memory store) to the full terminal box structure.
      document.querySelectorAll('.cmd:not(:has(.cmd-prompt))').forEach((btn) => {
        const codes = [...btn.querySelectorAll('code')].map((c) => c.textContent?.trim() ?? '').filter(Boolean);
        const td = btn.parentElement;
        if (!td) return;
        if (codes.length > 1) {
          td.innerHTML = `<div class="cmd-list">${codes.map(buildCommandBoxHtml).join('')}</div>`;
        } else {
          const single = codes[0] || btn.getAttribute('data-copy') || btn.textContent?.trim() || '';
          btn.outerHTML = buildCommandBoxHtml(single);
        }
      });

      // Upgrade any cached Ex commands rendered as <kbd class="key">:...</kbd> in hybrid tables.
      document.querySelectorAll('.key-table tr:not(.is-cmd-row)').forEach((row) => {
        const lastTd = row.querySelector('td:last-child');
        if (!lastTd) return;
        const keys = [...lastTd.querySelectorAll('kbd.key')];
        if (keys.length > 0 && keys.every((k) => (k.textContent?.trim() ?? '').startsWith(':'))) {
          row.classList.add('is-cmd-row');
          const cmds = keys.map((k) => k.textContent?.trim() ?? '');
          lastTd.innerHTML = cmds.length > 1 ? `<div class="cmd-list">${cmds.map(buildCommandBoxHtml).join('')}</div>` : buildCommandBoxHtml(cmds[0]);
        }
      });

      // Fallback for any standalone <pre> not already wrapped in a .term-window or figure:
      // wrap it in a .term-window header so the copy button always sits at the top-right.
      document.querySelectorAll('.prose pre').forEach((pre) => {
        if (pre.closest('.term-window') || pre.closest('figure')) return;
        pre.querySelector('.copy-btn')?.remove();

        const lang = pre.getAttribute('data-language') || 'terminal';
        const wrapper = document.createElement('div');
        wrapper.className = 'term-window not-prose';
        wrapper.innerHTML = `
          <div class="term-header">
            <div class="term-title">
              <span class="term-dots" aria-hidden="true">
                <span class="term-dot term-dot-red"></span>
                <span class="term-dot term-dot-amber"></span>
                <span class="term-dot term-dot-green"></span>
              </span>
              <span class="term-lang">${lang}</span>
            </div>
            <button type="button" class="copy-btn" aria-label="Copiar código">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="cmd-icon-copy"><path d="M19 21H8V7h11m0-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2m-3-4H4a2 2 0 0 0-2 2v14h2V3h12z" fill="currentColor"></path></svg>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="cmd-icon-done"><path d="M21 7 9 19l-5.5-5.5 1.41-1.41L9 16.17 19.59 5.59z" fill="currentColor"></path></svg>
              <span class="cmd-state-label">${COPY_LABEL}</span>
              <span class="cmd-state-done">¡Copiado!</span>
            </button>
          </div>
        `;
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);
      });

      const toast = document.getElementById('toast');
      let toastTimer: number | undefined;
      const showToast = (message: string) => {
        if (!toast) return;
        toast.textContent = message;
        toast.classList.add('is-visible');
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 1600);
      };

      // Clipboard API needs HTTPS/localhost; fall back for plain-HTTP LAN testing on phones.
      const writeClipboard = async (text: string) => {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          const area = document.createElement('textarea');
          area.value = text;
          area.setAttribute('readonly', '');
          area.style.cssText = 'position:fixed;top:0;left:0;opacity:0';
          document.body.appendChild(area);
          area.select();
          let ok = false;
          try {
            // eslint-disable-next-line deprecation/deprecation
          ok = document.execCommand('copy');
          } catch {
            ok = false;
          }
          area.remove();
          return ok;
        }
      };

      const flash = (button: Element) => {
        button.classList.add('is-copied');
        window.setTimeout(() => button.classList.remove('is-copied'), 1600);
      };

      // Event delegation covers command strips, auto-enhanced and explicit code blocks.
      document.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const cmd = target.closest('.cmd');
        const button = cmd ?? target.closest('.copy-btn');
        if (!button) return;

        let text = cmd
          ? button.getAttribute('data-copy')
          : button.getAttribute('data-code');
        if (!text) {
          text =
            button.closest('.term-window, figure, pre')?.querySelector('code')?.textContent ?? '';
        }

        if (await writeClipboard(text)) {
          flash(button);
          showToast('Copiado al portapapeles');
        } else {
          showToast('No se pudo copiar');
        }
      });

      // Expose the sticky header height so sticky/anchored elements can offset it.
      const header = document.querySelector('header');
      if (header) {
        const setHeaderHeight = () =>
          document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
        setHeaderHeight();
        new ResizeObserver(setHeaderHeight).observe(header);
      }

      // Masonry layout for the section cards on desktop: each card spans as many
      // small grid rows as its real height needs, so cards pack without gaps
      // while DOM (reading and tab) order stays intact.
      const grid = document.querySelector<HTMLElement>('.sheet-grid');
      if (grid) {
        const desktop = window.matchMedia('(min-width: 1024px)');
        const cards = [...grid.children] as HTMLElement[];
        let frame = 0;

        const layout = () => {
          frame = 0;
          if (!desktop.matches) {
            grid.classList.remove('is-masonry');
            cards.forEach((card) => (card.style.gridRowEnd = ''));
            return;
          }
          const styles = getComputedStyle(grid);
          const row = parseFloat(styles.getPropertyValue('--masonry-row')) || 8;
          const gap = parseFloat(styles.columnGap) || 24;
          grid.classList.add('is-masonry');
          cards.forEach((card) => {
            const span = Math.ceil((card.getBoundingClientRect().height + gap) / row);
            card.style.gridRowEnd = `span ${span}`;
          });
        };
        const schedule = () => {
          if (!frame) frame = requestAnimationFrame(layout);
        };

        // Cards change height when fonts load, the window resizes or the theme flips.
        const resizeObserver = new ResizeObserver(schedule);
        cards.forEach((card) => resizeObserver.observe(card));
        desktop.addEventListener('change', schedule);
        layout();
      }

      // Sticky section bar: edge fades, arrow buttons and the active section.
      const toc = document.querySelector<HTMLElement>('.sheet-toc');
      const tocList = toc?.querySelector<HTMLUListElement>('ul');
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.sheet-toc a');
      if (toc && tocList) {
        const updateEdges = () => {
          const max = tocList.scrollWidth - tocList.clientWidth;
          toc.toggleAttribute('data-at-start', tocList.scrollLeft <= 2);
          toc.toggleAttribute('data-at-end', tocList.scrollLeft >= max - 2);
        };
        tocList.addEventListener('scroll', updateEdges, { passive: true });
        new ResizeObserver(updateEdges).observe(tocList);
        updateEdges();

        toc.querySelectorAll<HTMLButtonElement>('.sheet-toc-arrow').forEach((arrow) => {
          arrow.addEventListener('click', () => {
            const dir = Number(arrow.dataset.dir);
            tocList.scrollBy({ left: dir * tocList.clientWidth * 0.7 });
          });
        });

        // Center the active chip inside the bar without scrolling the page vertically.
        const revealChip = (link: HTMLAnchorElement) => {
          const target = link.offsetLeft - (tocList.clientWidth - link.offsetWidth) / 2;
          tocList.scrollTo({ left: target });
        };
        const setActive = (link: HTMLAnchorElement | undefined) => {
          if (!link || link.hasAttribute('aria-current')) return;
          tocLinks.forEach((a) => a.removeAttribute('aria-current'));
          link.setAttribute('aria-current', 'true');
          revealChip(link);
        };

        // Clicking a chip marks it right away instead of waiting for the scroll.
        tocLinks.forEach((link) => link.addEventListener('click', () => setActive(link)));

        const byId = new Map(
          [...tocLinks].map((a) => [decodeURIComponent(a.hash.slice(1)), a] as const),
        );
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const id = entry.target.querySelector('h2')?.id ?? '';
              setActive(byId.get(id));
            }
          },
          { rootMargin: '-25% 0px -65% 0px' },
        );
        document.querySelectorAll('.sheet-section').forEach((section) => observer.observe(section));
      }

      // Expand / collapse long code blocks.
      document.querySelectorAll<HTMLButtonElement>('.term-expand').forEach((button) => {
        const lines = button.dataset.lines ?? '';
        button.addEventListener('click', () => {
          const win = button.closest('.term-window');
          const expanded = win?.classList.toggle('is-expanded') ?? false;
          button.setAttribute('aria-expanded', String(expanded));
          button.textContent = expanded ? 'Ver menos' : `Ver todo (${lines} líneas)`;
          if (!expanded) win?.scrollIntoView({ block: 'nearest' });
        });
      });

      // Back-to-top button after scrolling past roughly one screen.
      const toTop = document.getElementById('to-top');
      if (toTop) {
        const toggleToTop = () =>
          toTop.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.8);
        window.addEventListener('scroll', toggleToTop, { passive: true });
        toggleToTop();
        toTop.addEventListener('click', () => {
          window.scrollTo({ top: 0 });
          document.querySelector<HTMLElement>('main')?.focus({ preventScroll: true });
        });
      }
    </script>
  </body>
</html>
